# Copy this file to .env locally. Never commit the real .env file.
BOT_PROJECT_DIR=/absolute/path/to/Bot
BOT_NAME="Shahidulla Kaysar"
MESSENGER_GROUP_URL=https://www.facebook.com/messages/t/PUT_YOUR_GROUP_ID_HERE
BOT_USER_DATA_DIR=/absolute/path/to/Bot/bot_data_dir
MANUS_API_KEY=replace_with_a_new_manus_api_key
MANUS_API_BASE=https://api.manus.im
# Meta AI answers plain (non-command) mentions. Leave META_API_KEY blank to keep
# using Manus for chat too. muse-spark is a reasoning model, so META_MAX_TOKENS
# must stay high or replies come back empty.
META_API_KEY=replace_with_your_meta_api_key
META_API_BASE=https://api.meta.ai
META_MODEL=muse-spark-1.2
META_MAX_TOKENS=2048
MESSENGER_ENCRYPTION_PIN=replace_with_your_pin
BOT_POLL_SECONDS=5
BOT_CONTEXT_CHARACTERS=45000
BOT_MENTION_WINDOW=1200
BOT_MEDIA_TIMEOUT_SECONDS=360
# Older-message context: how many scroll-up rounds to load at startup and the
# maximum transcript size kept locally in bot_history.txt (never committed).
BOT_HISTORY_SCROLLS=40
BOT_HISTORY_CHARACTERS=120000
